{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "npm run prisma:generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "npm run dev",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "npm run prisma:generate && jest --config ./jest.config.ts --runInBand",
    "test:e2e": "npm run prisma:generate && jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@repo/validation": "*",
    "date-fns": "4.1.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.19",
    "@repo/typescript-config": "*",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "eslint": "10.3.0",
    "jest": "30.3.0",
    "prisma": "7.8.0",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.59.2"
  }
}

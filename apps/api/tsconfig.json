{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "incremental": false,
    "outDir": "./dist",
    "rootDir": "./src",
    // Rewrites all emitted relative .ts imports to .js in dist; needed here because Prisma's generated client kept .ts specifiers that broke node at runtime.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}

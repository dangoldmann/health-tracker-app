generator client {
  provider                = "prisma-client"
  output                  = "../src/generated/prisma"
  engineType              = "client"
  moduleFormat        = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum BiologicalSex {
  MALE
  FEMALE
  OTHER
}

enum GroupRole {
  ADMIN
  VIEWER
}

enum CheckupStatus {
  UPCOMING
  OVERDUE
  COMPLETED
}

enum DocumentType {
  ORDEN_MEDICA
  RESULTADO
  RECETA
}

enum DevicePlatform {
  ios
  android
  web
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  externalAuthId        String        @unique
  authProvider          String
  timezone              String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  ownedProfiles         Profile[]
  memberships           GroupMember[]
  deviceTokens          DeviceToken[]
}

model FamilyGroup {
  id        String        @id @default(uuid())
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   GroupMember[]
  profiles  Profile[]
}

model GroupMember {
  id            String      @id @default(uuid())
  familyGroupId String
  userId        String
  role          GroupRole   @default(VIEWER)
  permissions   Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, userId])
  @@index([userId])
}

model InsuranceProvider {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  countryCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profiles    Profile[]
}

model Profile {
  id                  String             @id @default(uuid())
  ownerId             String
  familyGroupId       String?
  insuranceProviderId String?
  name                String
  birthDate           DateTime
  biologicalSex       BiologicalSex
  riskFactors         Json               @default("{}")
  isSelf              Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  familyGroup         FamilyGroup?       @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  insuranceProvider   InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  checkups            UserCheckup[]

  @@index([ownerId])
  @@index([familyGroupId])
}

model CheckupType {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  baseFrequencyDays Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  protocols         MedicalProtocol[]
  checkups          UserCheckup[]
}

model MedicalProtocol {
  id                     String         @id @default(uuid())
  checkupTypeId          String
  minAge                 Int
  maxAge                 Int?
  sex                    BiologicalSex?
  suggestedFrequencyDays Int
  riskFactorKey          String?
  countryCode            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  checkupType            CheckupType    @relation(fields: [checkupTypeId], references: [id], onDelete: Cascade)
  sourcedCheckups        UserCheckup[]

  @@index([checkupTypeId, minAge, maxAge])
}

model UserCheckup {
  id                  String        @id @default(uuid())
  profileId           String
  checkupTypeId       String
  sourceProtocolId    String?
  lastPerformed       DateTime?
  customFrequencyDays Int?
  status              CheckupStatus @default(UPCOMING)
  nextDueAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  profile             Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checkupType         CheckupType   @relation(fields: [checkupTypeId], references: [id], onDelete: Cascade)
  sourceProtocol      MedicalProtocol? @relation(fields: [sourceProtocolId], references: [id], onDelete: SetNull)
  documents           MedicalDocument[]

  @@unique([profileId, checkupTypeId])
  @@index([profileId, status, nextDueAt])
}

model MedicalDocument {
  id         String       @id @default(uuid())
  checkupId  String
  storageKey String
  fileUrl    String?
  ocrData    Json?
  type       DocumentType
  uploadedAt DateTime     @default(now())
  checkup    UserCheckup  @relation(fields: [checkupId], references: [id], onDelete: Cascade)

  @@index([checkupId])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  pushToken  String         @unique
  platform   DevicePlatform
  timezone   String?
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
